{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keledon:mvp:interaction-profile:1",
  "title": "MVP experiment profile (configuration, never authorization)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "platform",
    "callSurface",
    "crmSurface",
    "objective",
    "requiredCapabilities",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "platform": {
      "const": "windows"
    },
    "callSurface": {
      "allOf": [
        {
          "$ref": "#/$defs/surface"
        }
      ],
      "properties": {
        "kind": {
          "const": "call"
        }
      }
    },
    "crmSurface": {
      "allOf": [
        {
          "$ref": "#/$defs/surface"
        }
      ],
      "properties": {
        "kind": {
          "const": "crm"
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "audio.captureRemote",
          "audio.sendSpeech",
          "audio.cancelSpeech",
          "interaction.observe",
          "interaction.confirm",
          "ui.searchCase",
          "ui.readCase"
        ]
      }
    },
    "triggerMode": {
      "enum": [
        "manual_arm",
        "acoustic_candidate_then_ui_confirmation"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxActionSteps",
        "actionTimeoutMs",
        "crmAccess"
      ],
      "properties": {
        "maxActionSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "actionTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "crmAccess": {
          "const": "read_only"
        },
        "bargeInStopTargetMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000
        }
      }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "origin"
      ],
      "properties": {
        "kind": {
          "enum": [
            "call",
            "crm"
          ]
        },
        "origin": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?$",
          "maxLength": 255,
          "description": "Syntax only. Existing server-resolved tenant authorization and URL/DNS/egress validation are mandatory; this profile grants no permission."
        }
      }
    }
  }
}
