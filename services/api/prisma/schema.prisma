generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== CORE ENTITIES ==========

model Company {
  id        String   @id @default(uuid())
  name      String
  industry  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countries CompanyCountry[]
  brands    Brand[]
  users     User[]
  managedInterfaces ManagedInterface[]
  tenantProviderConfigs TenantProviderConfig[]
  tenantVoiceProfiles   TenantVoiceProfile[]
  tenantFlowDefinitions TenantFlowConfigDefinition[]
  tenantIntentMappings TenantIntentFlowConfigMapping[]

  @@map("companies")
}

model CompanyCountry {
  id           String   @id @default(uuid())
  companyId    String
  countryCode  String   // ISO 3166-1 alpha-2 code
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, countryCode])
  @@map("company_countries")
}

model Brand {
  id        String   @id @default(uuid())
  companyId String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teams   Team[]

  @@map("brands")
}

model Team {
  id        String   @id @default(uuid())
  brandId   String?
  name      String
  country   String?  // ISO country code
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Provider configuration per team
  sttProvider String   @default("vosk")   // vosk, deepgram, webspeech, speaches
  ttsProvider String   @default("elevenlabs") // elevenlabs, webspeech
  
  // VOSK configuration
  voskServerUrl String?
  voskModel     String?
  
  // Deepgram configuration
  deepgramApiKey String?
  
  // Speaches configuration
  speachesApiUrl    String?   // Speaches server URL (e.g., https://speaches-production-c63f.up.railway.app)
  speachesApiKey    String?   // Speaches API key
  
  // ElevenLabs configuration
  elevenlabsApiKey String?

  // LLM (AI) provider selection
  llmProvider      String   @default("openai") // openai, google, anthropic, ollama
  
  // LLM API keys
  openaiApiKey     String?
  googleAiApiKey   String?
  anthropicApiKey  String?

  // TTS additional configuration
  ttsApiKey        String?  // Generic TTS API key (e.g., OpenAI TTS)
  ttsVoiceSettings String?
  ttsVoiceProfileId String?
  ttsVoiceId       String?  // Voice ID for TTS provider
  ttsEndpointUrl   String?  // Custom TTS endpoint URL (e.g., Kokoro API)

  // Escalation triggers - keywords that trigger human escalation
  escalationTriggers String[] @default(["sue", "lawsuit", "court", "lawyer", "attorney", "complain", "manager", "supervisor", "media", "news", "journalist", "social media"])
  
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  users    User[]
  keledons Keledon[]
  sessions Session[]
  teamInterfaces TeamInterface[]
  flows    Flow[]
  vendors Vendor[]

  @@map("teams")
}

model User {
  isActive     Boolean @default(true)
  authAfter    DateTime?
  id           String   @id @default(uuid())
  companyId     String?
  teamId        String?
  email         String   @unique
  name          String?
  role          String   @default("user") // user, admin, superadmin
  isOnline      Boolean  @default(false)
  lastLogin     DateTime?
  passwordHash  String?
  uatFixtureRunId String?
  uatFixtureExpiresAt DateTime?
  uatFixtureRetiredAt DateTime?
  uatFixtureAuthAfter DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id])
  team     Team?     @relation(fields: [teamId], references: [id])
  sessions Session[]
  keledons Keledon[]
  devices  Device[]

  @@map("users")
}

// A bounded synthetic run contains only generated fixture IDs, never credentials.
model UatFixtureRun {
  id        String @id
  createdBy String
  members   String
  expiresAt DateTime
  retiredAt DateTime?
  createdAt DateTime @default(now())

  @@index([retiredAt, expiresAt])
  @@map("uat_fixture_runs")
}

model Device {
  id              String   @id @default(uuid())
  userId          String?
  organizationId  String?
  keledonId       String?  // Links to Keledon agent
  name            String
  machineId       String   @unique
  platform        String   // win32, darwin, linux
  status          String   @default("pending") // pending, paired, disconnected, revoked
  pairingCode     String?
  pairingCodeExpiresAt DateTime?
  authToken       String?
  cdpUrl          String?
  lastSeen        DateTime?
  rpaProviderConfig String?  // JSON — RPA provider chain config
  version         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@map("devices")
}

model Keledon {
  id             String   @id @default(uuid())
  teamId          String
  brandId         String?
  countryCode     String?
  userId          String?
  name            String
  email           String?
  role            String?
  isActive        Boolean  @default(true)
  callsHandled    Int      @default(0)
  fcrRate         Float?
  avgHandleTime   Float?
  autonomyLevel   Int      @default(5)
  policies        String?  // JSON string
  uiInterfaces    String?  // JSON array of interface IDs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@map("agents")
}

// ========== MANAGED INTERFACES ==========

model ManagedInterface {
  id            String   @id @default(uuid())
  companyId     String?
  name          String
  baseUrl       String
  category      String?   // 'talk' | 'case'
  providerKey   String?
  capabilities  String?   // JSON string
  icon          String?
  status        String    @default("disconnected") // connected, disconnected, error
  credentials   String?   // JSON string
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamInterfaces TeamInterface[]

  @@index([companyId])
  @@map("managed_interfaces")
}

model TeamInterface {
  id         String   @id @default(uuid())
  teamId     String
  interfaceId String
  createdAt  DateTime @default(now())

  team     Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  managedInterface ManagedInterface @relation(fields: [interfaceId], references: [id], onDelete: Cascade)

  @@unique([teamId, interfaceId])
  @@map("team_interfaces")
}

// ========== WORKFLOWS ==========

model Workflow {
  id           String   @id @default(uuid())
  interfaceId  String?
  name         String
  description  String?
  trigger      String   // JSON: { type, value, confidence? }
  steps        String   // JSON array
  variables    String   // JSON object
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  flowRuns FlowRun[]

  @@map("workflows")
}

model FlowDefinition {
  id          String   @id @default(uuid())
  workflowId  String
  name        String
  definition  String   // JSON
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions FlowDefinitionVersion[]

  @@map("flow_definitions")
}

model FlowDefinitionVersion {
  id              String   @id @default(uuid())
  flowDefinitionId String
  version         Int
  definition      String   // JSON
  changelog       String?
  createdAt       DateTime @default(now())

  flowDefinition FlowDefinition @relation(fields: [flowDefinitionId], references: [id], onDelete: Cascade)

  @@unique([flowDefinitionId, version])
  @@map("flow_definition_versions")
}

model TenantFlowPermission {
  id           String   @id @default(uuid())
  tenantId     String
  workflowId   String
  canExecute   Boolean  @default(true)
  canEdit      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, workflowId])
  @@map("tenant_flow_permissions")
}

model IntentFlowMapping {
  id         String   @id @default(uuid())
  intent     String
  workflowId String
  confidence Int      @default(80)
  createdAt  DateTime @default(now())

  @@map("intent_flow_mappings")
}

// Tenant-owned MVP flow editor records, separate from legacy global workflows.
model TenantFlowConfigDefinition {
  id          String   @id @default(uuid())
  companyId   String?
  interfaceId String?
  name        String
  description String?
  category    String   @default("case")
  status      String   @default("active")
  intentTags  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

    company     Company?                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  versions    TenantFlowConfigVersion[]
  permissions TenantFlowConfigPermission[]

  @@index([companyId])
    @@unique([id, companyId])
  @@map("tenant_flow_config_definitions")
}

model TenantFlowConfigVersion {
  id               String   @id @default(uuid())
  flowDefinitionId String
  version          Int
  status           String   @default("draft")
  steps            Json     @default("[]")
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  flowDefinition TenantFlowConfigDefinition @relation(fields: [flowDefinitionId], references: [id], onDelete: Cascade)

  @@unique([flowDefinitionId, version])
  @@map("tenant_flow_config_versions")
}

model TenantFlowConfigPermission {
  id               String   @id @default(uuid())
  companyId        String
  flowDefinitionId String
  isEnabled        Boolean  @default(true)
  defaultForIntent String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

    flowDefinition TenantFlowConfigDefinition @relation(fields: [flowDefinitionId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([companyId, flowDefinitionId])
  @@map("tenant_flow_config_permissions")
}

model TenantIntentFlowConfigMapping {
  id                       String   @id @default(uuid())
  companyId                String
  intent                   String
  allowedFlowDefinitionIds String[] @default([])
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, intent])
  @@map("tenant_intent_flow_config_mappings")
}

model FlowRun {
  id           String   @id @default(uuid())
  workflowId   String?
  flowId       String?
  sessionId    String?
  status       String   @default("pending") // pending, running, completed, failed
  result       String?  // JSON
  error        String?
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  workflow Workflow? @relation(fields: [workflowId], references: [id])
  flow     Flow?     @relation(fields: [flowId], references: [id])
  session  Session? @relation(fields: [sessionId], references: [id])

  subAgentRuns SubAgentRun[]

  @@map("flow_runs")
}

model FlowRunEvidence {
  id        String   @id @default(uuid())
  runId     String
  type      String
  content   String
  createdAt DateTime @default(now())

  @@map("flow_run_evidence")
}

// ========== FLOWS (Enhanced) ==========

model Flow {
  id               String   @id @default(uuid())
  name             String
  description      String?
  triggerKeywords  String   // JSON array of keywords
  category         String   @default("general") // crm, support, sales, etc.
  tool             String   @default("browser") // browser, genesys, salesforce, etc.
  teamId           String?
  isActive         Boolean  @default(true)
  version          Int      @default(1)
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  team      Team?     @relation(fields: [teamId], references: [id])
  steps     FlowStep[]
  runs      FlowRun[]

  @@map("flows")
}

model FlowStep {
  id           String   @id @default(uuid())
  flowId       String
  order        Int
  type         String   // navigate, click, input, read, wait, submit, decision, speak
  selector     String?  // CSS selector or XPath
  selectorType String   @default("css") // css, xpath, text, aria
  value        String?  // For input steps
  extract      String?  // Variable name to extract
  waitFor      String?  // Selector to wait for
  condition    String?  // For decision steps
  timeout      Int      @default(10000) // ms
  optional     Boolean  @default(false)
  nextStepId   String?  // For branching
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
  @@map("flow_steps")
}

// ========== SUBAGENTS ==========

model SubAgent {
  id          String   @id @default(uuid())
  name        String
  role        String   // listener, processor, tool-operator, flow-executor
  status      String   @default("idle") // idle, active, waiting, error
  sessionId   String?
  currentTask String?  // JSON: current operation
  maxParallel Int      @default(1)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session Session?     @relation(fields: [sessionId], references: [id])
  runs    SubAgentRun[]

  @@map("sub_agents")
}

model SubAgentRun {
  id           String   @id @default(uuid())
  subAgentId   String
  flowRunId    String?
  flowId       String?
  flowStepIds  String?  // JSON array of step IDs being executed
  status       String   @default("pending") // pending, running, completed, failed
  result       String?  // JSON: extracted data, execution log
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  subAgent SubAgent @relation(fields: [subAgentId], references: [id])
  flowRun  FlowRun? @relation(fields: [flowRunId], references: [id])

  @@index([subAgentId])
  @@index([flowRunId])
  @@map("sub_agent_runs")
}

// ========== PROVIDERS ==========

model ProviderCatalog {
  id          String   @id @default(uuid())
  type        String   // 'stt' | 'tts' | 'rpa'
  name        String
  description String?
  status      String   @default("production") // experimental, production, deprecated
  isEnabled   Boolean  @default(true)
  metadata    String?  // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantProviderConfigs TenantProviderConfig[]
  tenantVoiceProfiles   TenantVoiceProfile[]

  @@map("provider_catalog")
}

model TenantProviderConfig {
  id           String   @id @default(uuid())
  companyId    String
  providerId   String
  providerType String   // 'stt' | 'tts' | 'rpa'
  isEnabled    Boolean  @default(true)
  isDefault    Boolean  @default(false)
  limits       String?  // JSON
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  providerCatalog ProviderCatalog @relation(fields: [providerId], references: [id])

  @@unique([companyId, providerId])
  @@map("tenant_provider_config")
}

model TenantVoiceProfile {
  id           String   @id @default(uuid())
  companyId    String
  providerId   String
  name         String
  language     String   @default("en")
  isEnabled    Boolean  @default(true)
  isDefault    Boolean  @default(false)
  config       String?  // JSON
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  providerCatalog ProviderCatalog @relation(fields: [providerId], references: [id])

  @@map("tenant_voice_profiles")
}

// ========== SESSIONS (Existing) ==========

model Session {
  id        String   @id @default(uuid())
  userId    String?
  teamId    String?
  status    String?
  metadata  String?  // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?      @relation(fields: [userId], references: [id])
  team      Team?      @relation(fields: [teamId], references: [id])
  events    Event[]
  flowRuns  FlowRun[]
  subAgents SubAgent[]

  @@map("sessions")
}

model Event {
  id        String   @id @default(uuid())
  sessionId String
  type      String
  payload   String?  // JSON
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("events")
}

// ========== KNOWLEDGE / RAG ==========

model KnowledgeBase {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents KnowledgeDocument[]

  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id           String   @id @default(uuid())
  knowledgeBaseId String
  title        String
  content      String
  metadata     String?  // JSON
  vectorIds    String?  // Comma-separated vector IDs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@map("knowledge_documents")
}

// ========== AUDIT LOG ==========

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  companyId String?  // Snapshot of the actor's tenant when the event was recorded; deliberately not a relation.
  action    String
  entity    String
  entityId  String?
  changes   String?  // JSON
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ========== FEATURE FLAGS ==========

model FeatureFlag {
  id        String    @id @default(uuid())
  name      String    @unique
  enabled   Boolean   @default(false)
  scope     String    @default("global") // global, tenant, user
  scopeId   String?   // tenant_id or user_id depending on scope
  metadata  String?   // JSON for additional config
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  @@index([scope, scopeId])
  @@map("feature_flags")
}

// ========== ESCALATION LOGS ==========

model EscalationLog {
  id            String   @id @default(uuid())
  sessionId     String?
  teamId        String?
  deviceId      String?
  trigger       String
  triggerType   String   @default("keyword") // keyword, manual, system
  transcript    String?
  status        String   @default("triggered") // triggered, acknowledged, resolved, aborted
  metadata      String?  // JSON
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sessionId])
  @@index([teamId])
  @@index([status])
  @@map("escalation_logs")
}

// ========== DEBUG MODE ==========

model DebugMode {
  id          String    @id @default(uuid())
  isActive    Boolean   @default(false)
  activatedBy String?   // user_id who activated
  activatedAt DateTime?
  expiresAt   DateTime?
  autoExpire  Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("debug_mode")
}

// ========== VENDORS ==========

model Vendor {
  id          String   @id @default(uuid())
  teamId      String
  name        String   // e.g., "Salesforce", "Genesys", "HubSpot"
  type        String   // "crm", "telephony", "helpdesk", "other"
  baseUrl     String?  // e.g., "https://login.salesforce.com"
  username    String?  // encrypted at rest; masked in API projections
  password    String?  // encrypted
  apiKey      String?  // encrypted
  config      Json?    // non-secret config, including tenant-validated allowed origins
  startGoal   String?  // startup instructions for the vendor agent
  isActive   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("vendors")
}

// Managed AI definitions and measured usage; additive migration, no runtime schema writes.
model AiPromptDefinition {
  id String @id
  name String
  personalityPrompt String
  executionPrompt String
  outputSchemaJson Json
  enabled Boolean @default(true)
  purpose String @default("")
  owningFeature String @default("")
  callsite String @default("")
  inputSchemaJson Json @default("{}")
  outputDestination String @default("product")
  nextHops Json @default("[]")
  revision Int @default(1)
  publishedRevision Int @default(1)
  publishedDefinition Json @default("{}")
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions AiPromptRevision[]
  usage AiCallUsage[]
  @@map("ai_prompt_definitions")
}

model AiPromptRevision {
  id String @id @default(uuid())
  promptId String
  fromRevision Int
  toRevision Int
  actorId String
  changedFields Json
  definitionSnapshot Json?
  publishedAt DateTime?
  publishedBy String?
  createdAt DateTime @default(now())
  prompt AiPromptDefinition @relation(fields: [promptId], references: [id], onDelete: Restrict)
  @@unique([promptId, toRevision])
  @@map("ai_prompt_revisions")
}

model PlatformSetting {
  key       String   @id
  value     Json
  revision  Int      @default(1)
  updatedBy String
  updatedAt DateTime @updatedAt
  @@index([updatedAt])
  @@map("platform_settings")
}

model AiCallUsage {
  id String @id @default(uuid())
  promptId String
  promptRevision Int
  feature String
  teamId String?
  provider String
  requestedModel String
  responseModel String?
  inputTokens Int?
  outputTokens Int?
  latencyMs Int
  costUsd Float?
  pricingMetadata Json?
  errorCode String?
  createdAt DateTime @default(now())
  prompt AiPromptDefinition @relation(fields: [promptId], references: [id], onDelete: Restrict)
  @@index([createdAt])
  @@index([promptId, createdAt])
  @@map("ai_call_usage")
}
